<?xml version='1.0' encoding='utf-8'?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.ecat</groupId>
    <artifactId>ecat-project</artifactId>
    <version>3.0.0</version>
    <relativePath />
  </parent>
  <artifactId>integration-env-qc-manager</artifactId>
  <version>3.0.1</version>
  <name>integration-env-qc-manager</name>
  <dependencies>
    <dependency>
      <groupId>com.ecat</groupId>
      <artifactId>ruoyi-system</artifactId>
      <version>3.0.1</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>com.ecat</groupId>
      <artifactId>ruoyi-framework</artifactId>
      <version>3.0.1</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter</artifactId>
      <version>2.5.15</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
      <version>2.5.15</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <version>2.5.15</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
      <version>2.5.15</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>com.ecat</groupId>
      <artifactId>integration-ecat-core-ruoyi</artifactId>
      <version>3.0.0</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>com.ecat</groupId>
      <artifactId>integration-env-calibration-composer</artifactId>
      <version>3.0.1</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>com.ecat</groupId>
      <artifactId>integration-env-data-manager</artifactId>
      <version>3.1.0</version>
      <scope>provided</scope>
    </dependency>
    <!-- ADM 数据 SDK：质控过程展示数据源（adm_data_sample 秒级曲线/最新行 + 参数目录）。
         provided 同 JVM 由 core 动态加载（同本 pom 其它 integration 依赖写法）；只 import ADM jar 的 api 契约包。 -->
    <dependency>
      <groupId>com.ecat</groupId>
      <artifactId>integration-env-air-device-manager</artifactId>
      <version>3.1.0</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>com.ecat</groupId>
      <artifactId>ecat-core</artifactId>
      <version>3.1.0</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>com.ecat</groupId>
      <artifactId>integration-logicdevice</artifactId>
      <version>3.1.0</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>com.ecat</groupId>
      <artifactId>integration-logicdevice-airstation</artifactId>
      <version>3.1.0</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>com.ecat</groupId>
      <artifactId>integration-logicdevice-airdevice</artifactId>
      <version>3.1.0</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-inline</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- 仅 SDK 读面真库符合性 IT（QcmSdkCloudDbConformanceIT，手动门控）用：PG JDBC 直连部署云库，
         生产 mapper XML 在真库上跑 SELECT。不进运行时依赖（运行时驱动由 ruoyi-admin 提供）。 -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <version>42.2.27</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <includes>
          <include>**/*</include>
        </includes>
        <excludes>
          <exclude>**/node_modules/**</exclude>
          <exclude>**/package-lock.json</exclude>
        </excludes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-assembly-plugin</artifactId>
        <version>3.6.0</version>
        <configuration>
          <descriptors>
            <descriptor>src/main/assembly/fatjar.xml</descriptor>
          </descriptors>
          <appendAssemblyId>false</appendAssemblyId>
          <archiverConfig>
            <compress>false</compress>
          </archiverConfig>
        </configuration>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>single</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
      <comments>This integration is part of ECAT Project and licensed under Apache 2.0</comments>
    </license>
  </licenses>
</project>
